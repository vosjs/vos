{
  "name": "@vosjs/render-core",
  "version": "0.1.0",
  "description": "The render harness for deterministic vos renders: timeline-sharded chunk planning and stream-copy chunk concat. Pixels stay in the browser; this package owns the orchestration math and the Node-side media plumbing.",
  "license": "MIT",
  "author": "vosso",
  "homepage": "https://vos.so",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vosjs/vos.git",
    "directory": "packages/render-core"
  },
  "bugs": {
    "url": "https://github.com/vosjs/vos/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "mediabunny": "^1.27.3"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
