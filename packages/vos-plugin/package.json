{
  "name": "@vosso/vos-plugin",
  "version": "0.22.0",
  "description": "The take pipeline and the vos.so verbs of the vos CLI: record the real product from a scripted browser flow, auto-zoom from the cursor track, cut as data in doc.json, render deterministic video and stills, deliver a release's media per destination spec, and sync with vos.so (fetch/push/pull/login, folders). No bin of its own; verbs surface through the `vos` binary (@vosjs/cli), which delegates every non-engine verb here.",
  "type": "module",
  "license": "MIT",
  "author": "vosso",
  "homepage": "https://vos.so",
  "bugs": {
    "url": "https://github.com/vosjs/vos/issues"
  },
  "keywords": [
    "vos",
    "vosso",
    "screen-recording",
    "product-video",
    "demo",
    "auto-zoom",
    "agent",
    "cli"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@vosjs/core": "^0.23.1",
    "@vosjs/editor": "^1.3.0",
    "@vosjs/elements": "^0.8.0",
    "@vosjs/timeline": "^0.4.0",
    "@vosjs/tween": "^0.8.1",
    "mediabunny": "^1.27.3",
    "playwright": "^1.49.0"
  },
  "peerDependencies": {
    "@vosjs/cli": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@vosjs/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vosso/render-core": "workspace:*",
    "@vosso/shared": "workspace:*",
    "@vosso/studio-core": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
