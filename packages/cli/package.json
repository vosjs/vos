{
  "name": "@vosjs/cli",
  "version": "0.16.0",
  "description": "The vos CLI: record the real product from a scripted browser flow, auto-zoom from the cursor track, cut as data in doc.json, render deterministic video and stills, deliver a release's media per destination spec, and sync with vos.so. One binary, every verb, MIT.",
  "type": "module",
  "license": "MIT",
  "author": "vosso",
  "homepage": "https://vos.so/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vosjs/vos.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/vosjs/vos/issues"
  },
  "keywords": [
    "vos",
    "cli",
    "video",
    "render",
    "deterministic",
    "headless",
    "agent",
    "animation",
    "three",
    "screen-recording",
    "product-video",
    "demo",
    "auto-zoom"
  ],
  "bin": {
    "vos": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@vosjs/core": "workspace:^",
    "@vosjs/editor": "workspace:^",
    "@vosjs/elements": "workspace:^",
    "@vosjs/render-core": "workspace:^",
    "@vosjs/shared": "workspace:^",
    "@vosjs/studio-core": "workspace:^",
    "@vosjs/timeline": "workspace:^",
    "@vosjs/tween": "workspace:^",
    "mediabunny": "^1.27.3",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
