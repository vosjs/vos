{
  "name": "@vosjs/cli",
  "version": "0.96.2",
  "description": "Record a product demo video from the command line: a script or your coding agent (Claude Code, Codex, Cursor) drives the real app, zooms are planned from the cursor track, the cut is data in doc.json, and renders are deterministic. Also every vos engine verb and the vos.so sync. One binary, MIT.",
  "type": "module",
  "license": "MIT",
  "author": "vosso",
  "homepage": "https://vos.so/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vosjs/vos.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/vosjs/vos/issues"
  },
  "keywords": [
    "vos",
    "cli",
    "video",
    "render",
    "deterministic",
    "headless",
    "agent",
    "animation",
    "three",
    "screen-recording",
    "screen-recorder",
    "product-video",
    "product-demo",
    "demo-video",
    "demo",
    "auto-zoom",
    "claude-code",
    "codex",
    "cursor",
    "agent-skills",
    "playwright"
  ],
  "bin": {
    "vos": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "skills"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "sync-skills": "node scripts/sync-skills.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@vosjs/core": "workspace:^",
    "@vosjs/driver": "^0.4.1",
    "@vosjs/editor": "workspace:^",
    "@vosjs/elements": "workspace:^",
    "@vosjs/render-core": "workspace:^",
    "@vosjs/shared": "workspace:^",
    "@vosjs/studio-core": "workspace:^",
    "@vosjs/timeline": "workspace:^",
    "@vosjs/tween": "workspace:^",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "mediabunny": "^1.55.7",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
